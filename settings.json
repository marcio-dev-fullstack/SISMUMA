{
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "files.associations": {
    ".env.example": "ini"
  },
  "locale": "pt-br"
  ,
  // --- Configurações do Formatador (Laravel Pint) ---
  "[php]": {
    "editor.defaultFormatter": "open-southeners.laravel-pint",
    "editor.formatOnSave": true
  },
  // Habilita a execução do Pint via Docker
  "laravel-pint.enableDocker": true,
  // Comando para executar o Pint dentro do contêiner
  // Usamos os mesmos arquivos de compose do script gerenciar.ps1
  "laravel-pint.dockerCommand": "docker compose -f docker-compose.yml -f docker-compose.override.yml exec -T app"
}
